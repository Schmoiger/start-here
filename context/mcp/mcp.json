{
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "fc-4d6d3fc4c1494fd5872995574a50578d"
      },
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": [
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "ctx7sk-7dd7b507-02e1-4d5b-bcd0-0dfc3398b057"
      },
      "disabled": false
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "navigate_page",
        "wait_for",
        "list_console_messages",
        "evaluate_script",
        "new_page",
        "take_snapshot",
        "take_screenshot",
        "click",
        "list_pages",
        "select_page",
        "fill",
        "list_network_requests"
      ]
    },
    "playwright": {
      "command": "uvx",
      "args": [
        "playwright-mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "playwright_goto",
        "playwright_click",
        "playwright_fill",
        "playwright_screenshot",
        "playwright_get_text",
        "playwright_wait_for_selector",
        "playwright_evaluate",
        "new_page"
      ]
    }
  }
}